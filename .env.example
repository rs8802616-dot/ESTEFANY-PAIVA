# =====================================================================
# VARIÁVEIS DE AMBIENTE (CONFIGURAR APENAS NA VERCEL — NUNCA COMITAR SEUS SEGREDOS)
# =====================================================================

# Hash SHA-256 do token secreto da URL do painel administrativo (/painel?k=SEU_TOKEN)
VITE_ADMIN_TOKEN_HASH=coloque_aqui_apenas_o_hash_sha256_do_seu_token

# E-mail autorizado da administradora no Firebase Authentication (E-mail e Senha)
VITE_ADMIN_EMAIL=seu_email_admin@exemplo.com
