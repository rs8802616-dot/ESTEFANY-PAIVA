# =====================================================================
# TEMPLATE DE CONFIGURAÇÃO - AMBIENTE & SEGURANÇA (LGPD & ZERO-LEAK)
# Copie este arquivo para .env e preencha com seus dados de produção.
# NUNCA comite o arquivo .env no Git!
# =====================================================================

# Configurações do Servidor
PORT=3000
NODE_ENV=production
APP_BASE_URL=https://seudominio.com

# Chaves Criptográficas de Acesso (Geradas via CSPRNG)
# Nota: No banco de dados são armazenados apenas os hashes SHA-256 destes tokens!
ADMIN_TOKEN_SECRET=gerar_token_aleatorio_seguro_admin_aqui
MASTER_TOKEN_SECRET=gerar_token_aleatorio_seguro_master_aqui

# Criptografia de Dados Pessoais (LGPD Art. 6º, III - AES-256-GCM)
LGPD_ENCRYPTION_KEY_32BYTES=insira_uma_chave_hexadecimal_de_32_bytes_aqui
LGPD_RETENTION_DAYS=90

# Notificações Web Push PWA (VAPID / RFC 8292)
VAPID_PUBLIC_KEY=sua_chave_publica_vapid_aqui
VAPID_PRIVATE_KEY=sua_chave_privada_vapid_aqui
VAPID_SUBJECT_MAILTO=mailto:contato@seudominio.com

# Integração Google Calendar (OAuth 2.0)
GOOGLE_CLIENT_ID=seu_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=https://seudominio.com/api/auth/google/callback

# WhatsApp API (Opcional - caso contrate disparador oficial)
WHATSAPP_API_TOKEN=seu_token_whatsapp_aqui
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
