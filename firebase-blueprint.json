{
  "entities": {
    "SalonSettings": {
      "title": "SalonSettings",
      "description": "Global studio configuration, professional profile, working slots, blocked dates, monthly goal, and Pix details for Estefany Paiva Nails v36.",
      "type": "object",
      "properties": {
        "studioName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "tagline": { "type": "string", "maxLength": 160 },
        "ownerName": { "type": "string", "maxLength": 80 },
        "bio": { "type": "string", "maxLength": 260 },
        "avatarImage": { "type": "string", "maxLength": 250000 },
        "heroTitle": { "type": "string", "maxLength": 120 },
        "heroSubtitle": { "type": "string", "maxLength": 240 },
        "heroImageUrl": { "type": "string", "maxLength": 250000 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "instagram": { "type": "string", "maxLength": 60 },
        "address": { "type": "string", "maxLength": 200 },
        "pixKey": { "type": "string", "maxLength": 120 },
        "pixName": { "type": "string", "maxLength": 80 },
        "pixCity": { "type": "string", "maxLength": 60 },
        "depositPercent": { "type": "number" },
        "rescheduleMinHours": { "type": "number" },
        "monthlyGoal": { "type": "number" },
        "openTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "closeTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "slotIntervalMinutes": { "type": "number" },
        "configuredSlots": { "type": "array", "description": "Optional explicit HH:mm slots (0..48 items)." },
        "workDays": { "type": "array", "description": "Active weekdays 0 (Sun) through 6 (Sat), 1..7 items." },
        "blockedDates": { "type": "array", "description": "Closed dates YYYY-MM-DD (0..120 items)." },
        "returnAlertDays": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "studioName",
        "tagline",
        "ownerName",
        "bio",
        "avatarImage",
        "heroTitle",
        "heroSubtitle",
        "heroImageUrl",
        "whatsapp",
        "instagram",
        "address",
        "pixKey",
        "pixName",
        "pixCity",
        "depositPercent",
        "rescheduleMinHours",
        "monthlyGoal",
        "openTime",
        "closeTime",
        "slotIntervalMinutes",
        "configuredSlots",
        "workDays",
        "blockedDates",
        "returnAlertDays",
        "updatedAt"
      ]
    },
    "Category": {
      "title": "Category",
      "description": "Service catalog category.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "order": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "order", "active", "createdAt", "updatedAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Nail procedure offered in the studio catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "categoryId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "description": { "type": "string", "maxLength": 400 },
        "price": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 250000 },
        "featured": { "type": "boolean" },
        "active": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "categoryId",
        "description",
        "price",
        "durationMinutes",
        "imageUrl",
        "featured",
        "active",
        "order",
        "createdAt",
        "updatedAt"
      ]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Private client appointment record containing PII, isolated to authenticated owner client and admin, with rotating bookingToken for optional guest self-management.",
      "type": "object",
      "properties": {
        "clientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "clientPhone": { "type": "string", "minLength": 8, "maxLength": 25 },
        "clientEmail": { "type": "string", "maxLength": 120 },
        "serviceIds": { "type": "array", "description": "Selected service IDs (1..10)." },
        "serviceNames": { "type": "array", "description": "Selected service display names (1..10)." },
        "totalPrice": { "type": "number" },
        "totalDurationMinutes": { "type": "number" },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "endTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["pix", "presencial"] },
        "pixPaid": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 500 },
        "rescheduleCount": { "type": "number" },
        "bookingToken": { "type": "string", "minLength": 12, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "lastVerifiedToken": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clientUid",
        "clientName",
        "clientPhone",
        "clientEmail",
        "serviceIds",
        "serviceNames",
        "totalPrice",
        "totalDurationMinutes",
        "date",
        "startTime",
        "endTime",
        "status",
        "paymentMethod",
        "pixPaid",
        "notes",
        "rescheduleCount",
        "bookingToken",
        "lastVerifiedToken",
        "createdAt",
        "updatedAt"
      ]
    },
    "AvailabilitySlot": {
      "title": "AvailabilitySlot",
      "description": "Public zero-PII busy time block synchronized atomically with appointments and personal blocks for duration-aware calendar blocking.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "endTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "durationMinutes": { "type": "number" },
        "kind": { "type": "string", "enum": ["appointment", "block"] },
        "active": { "type": "boolean" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "startTime", "endTime", "durationMinutes", "kind", "active", "ownerUid", "updatedAt"]
    },
    "PersonalBlock": {
      "title": "PersonalBlock",
      "description": "Admin-only personal schedule block (breaks, days off, courses).",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "date": { "type": "string", "minLength": 10, "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "endTime": { "type": "string", "minLength": 5, "maxLength": 5, "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "allDay": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "date", "startTime", "endTime", "allDay", "createdAt", "updatedAt"]
    },
    "ClientTechNote": {
      "title": "ClientTechNote",
      "description": "Admin-only client technical nail card (Ficha Técnica) storing preferences, gel brands, and allergies.",
      "type": "object",
      "properties": {
        "clientName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "clientPhone": { "type": "string", "minLength": 6, "maxLength": 25 },
        "nailFormat": { "type": "string", "maxLength": 50 },
        "gelBrand": { "type": "string", "maxLength": 100 },
        "favoriteColors": { "type": "string", "maxLength": 160 },
        "allergies": { "type": "string", "maxLength": 240 },
        "cuticleNotes": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "clientName",
        "clientPhone",
        "nailFormat",
        "gelBrand",
        "favoriteColors",
        "allergies",
        "cuticleNotes",
        "notes",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator UID allowlist document.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/salon_settings/{settingId}": {
      "schema": { "$ref": "#/entities/SalonSettings" },
      "description": "Studio public settings document (main)."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Public nail service categories."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Public nail studio procedures."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private client appointment records with PII restricted to owner and admin."
    },
    "/availability_slots/{slotId}": {
      "schema": { "$ref": "#/entities/AvailabilitySlot" },
      "description": "Zero-PII busy time windows used by the public calendar for duration blocking."
    },
    "/personal_blocks/{blockId}": {
      "schema": { "$ref": "#/entities/PersonalBlock" },
      "description": "Admin-only personal schedule blocks."
    },
    "/client_tech_notes/{noteId}": {
      "schema": { "$ref": "#/entities/ClientTechNote" },
      "description": "Admin-only client technical nail sheets (Ficha Técnica)."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted studio administrator records."
    }
  }
}
